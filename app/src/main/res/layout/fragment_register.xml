<?xml version="1.0" encoding="utf-8"?>
<!--Layout principal de la actividad-->
<!--Use un ConstraintLayout-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--Sección superior: fondo azul con ícono y textos-->
    <LinearLayout
        android:id="@+id/upperSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/deepBlue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/lowerSection"
        app:layout_constraintHeight_percent="0.45">

        <!--ImageView del ícono para regresarse-->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            app:srcCompat="@drawable/backicon" />

        <!--ImageView del ícono de registro-->
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            app:srcCompat="@drawable/registericon" />

        <!--TextView "Bienvenida"-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="¡Bienvenido!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/pearlWhite" />

        <!--TextView "Registro"-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:text="Registrate para continuar"
            android:textSize="16sp"
            android:textColor="@color/pearlWhite" />
    </LinearLayout>

    <!--Sección inferior: fondo blanco con inputs y botones-->
    <LinearLayout
        android:id="@+id/lowerSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/pearlWhite"
        app:layout_constraintTop_toBottomOf="@id/upperSection"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.55">

        <!--Campo de nombre-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:textColor="@color/carbonBlack"
            android:text="Nombre:" />

        <EditText
            android:id="@+id/nameEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:hint="Nombre"
            android:textColor="@color/carbonBlack"
            android:inputType="textEmailAddress" />


        <!--Campo de correo-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:textColor="@color/carbonBlack"
            android:text="Correo:" />

        <EditText
            android:id="@+id/emailEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:hint="Correo"
            android:textColor="@color/carbonBlack"
            android:inputType="textEmailAddress" />

        <!--Campo de contraseña-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:textColor="@color/carbonBlack"
            android:text="Contraseña:" />

        <EditText
            android:id="@+id/passwordEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:hint="Contraseña"
            android:textColor="@color/carbonBlack"
            android:inputType="textPassword" />

        <!--Botón de continuar-->
        <!--Nuevamente usé uno de los botones del Material Design-->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="59dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:backgroundTint="@color/blueButton"
            android:text="Continuar"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            app:cornerRadius="16dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
