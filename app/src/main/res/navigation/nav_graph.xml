<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!--Fragmento de Login-->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.intellitasks.LoginFragment"
        android:label="LoginFragment" >

        <!--Acción para navegar al RegisterFragment-->
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />

        <!--Acción para navegar a MainActivity después de un login exitoso-->
        <action
            android:id="@+id/action_loginFragment_to_mainActivity"
            app:destination="@id/mainActivity" />
    </fragment>

    <!--Fragmento de Registro-->
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.intellitasks.RegisterFragment"
        android:label="RegisterFragment" >

        <!--Acción para navegar a MainActivity después de un registro exitoso-->
        <action
            android:id="@+id/action_registerFragment_to_mainActivity"
            app:destination="@id/mainActivity" />
    </fragment>

    <!--MainActivity-->
    <activity
        android:id="@+id/mainActivity"
        android:name="com.example.intellitasks.MainActivity"
        android:label="activity_main"
        tools:layout="@layout/activity_main" />
</navigation>
